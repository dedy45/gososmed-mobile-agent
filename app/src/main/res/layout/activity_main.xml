<?xml version="1.0" encoding="utf-8"?>
<!--
  UI v0.5.0 — tab-based, TANPA scroll halaman panjang.
  Struktur tetap: header + banner status + TabLayout (Beranda/Setup/Log).
  Hanya konten tab yang bisa scroll internal bila layar kecil; tinggi panel
  dikunci (weight=1) sehingga tombol & log tidak pernah "hanyut".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- ===== BANNER STATUS (selalu terlihat, tidak ikut scroll) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/statusBigTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● MEMERIKSA…"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/status_idle" />

        <TextView
            android:id="@+id/statusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- ===== TABS ===== -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="?android:attr/textColorSecondary" />

    <!-- ===== KONTEN TAB (tinggi terkunci; scroll internal per tab) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB: BERANDA -->
        <ScrollView
            android:id="@+id/panelBeranda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/GosoSectionLabel"
                    android:layout_marginTop="14dp"
                    android:text="Perangkat ini" />

                <TextView
                    android:id="@+id/deviceInfoTv"
                    style="@style/GosoCard"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textSize="13sp" />

                <TextView
                    style="@style/GosoSectionLabel"
                    android:layout_marginTop="16dp"
                    android:text="Hubungkan ke GoSosmed" />

                <TextView
                    android:id="@+id/pairHintTv"
                    style="@style/GosoHint"
                    android:layout_marginTop="6dp"
                    android:text="@string/pair_hint" />

                <EditText
                    android:id="@+id/pairCodeEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/pair_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="8"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/connectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Hubungkan" />

                <Button
                    android:id="@+id/disconnectBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Putuskan Sambungan" />

                <TextView
                    android:id="@+id/pairTv"
                    style="@style/GosoHint"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <!-- ===== MODE DEBUG (tap 7× versi) ===== -->
                <LinearLayout
                    android:id="@+id/debugSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/GosoSectionLabel"
                        android:text="Mode debug" />

                    <EditText
                        android:id="@+id/wsUrlEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Override URL WS (kosong = default produksi)"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/dumpBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dump"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/packageBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Package"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/backBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Back"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/homeBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Home"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/tapBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap First Clickable"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB: SETUP -->
        <ScrollView
            android:id="@+id/panelSetup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- ============================================================
                     v0.9.0 — TIGA LANGKAH BERURUTAN.

                     Struktur ini mencerminkan kontrak docs/SETUP-3-LANGKAH.md:
                       Langkah 1 (WAJIB)   : Aksesibilitas
                       Langkah 2 (WAJIB)   : Izin "tampilkan di atas aplikasi lain"
                       Langkah 3 (OPSIONAL): Otomasi Lanjutan (ADB lokal)

                     Sebelum v0.9.0 tidak ada kartu izin overlay sama sekali,
                     padahal izin itu WAJIB (tanpa itu Android menelan permintaan
                     buka aplikasi tanpa error). Itu sebabnya pengguna bisa
                     merasa "sudah mengaktifkan semua" tetapi otomasi tetap gagal.
                     ============================================================ -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Langkah 1 — Wajib"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Langkah 1: Aksesibilitas -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/permA11yTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Akses otomatisasi (Aksesibilitas)"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Inti otomatisasi: membaca layar dan mengetuk atas persetujuan Anda." />

                    <Button
                        android:id="@+id/openAccessibilityBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Aktifkan" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Langkah 2 — Wajib"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Langkah 2: Izin overlay (BAL) — BARU di v0.9.0 -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/permOverlayTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tampilkan di atas aplikasi lain"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Sejak Android 10, tanpa izin ini sistem membatalkan permintaan membuka Instagram/TikTok/Facebook/Threads/YouTube TANPA pesan error apa pun." />

                    <Button
                        android:id="@+id/openOverlayBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Aktifkan" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Langkah 3 — Opsional"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Langkah 3: Otomasi Lanjutan / ADB lokal (v0.9.0) -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/adbStatusTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Otomasi Lanjutan (ADB)"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Opsional. Membuat pembukaan aplikasi lebih andal (terutama TikTok). Cukup untuk sebagian besar pemakaian tanpa langkah ini. Perlu diulang setiap HP selesai di-restart — itu perilaku Android, bukan aplikasi ini. Tidak perlu memasang aplikasi tambahan apa pun." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/adbPairBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hubungkan" />

                        <Button
                            android:id="@+id/adbForgetBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Putuskan"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Dukungan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Baterai -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/permBatteryTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bebas hemat baterai"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Mencegah Android mematikan agent di latar belakang (penting di Xiaomi/Oppo/Vivo)." />

                    <Button
                        android:id="@+id/batteryBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Bebaskan" />
                </LinearLayout>

                <!-- Notifikasi -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/permNotifTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notifikasi"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Menampilkan status koneksi agent yang sedang berjalan." />

                    <Button
                        android:id="@+id/notifBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Izinkan" />
                </LinearLayout>

                <!-- Pembaruan aplikasi (v0.7.0) -->
                <LinearLayout
                    style="@style/GosoCard"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pembaruan aplikasi"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/updateInfoTv"
                        style="@style/GosoHint"
                        android:layout_marginTop="2dp"
                        android:text="Versi terbaru dicek otomatis setiap tersambung ke server. Tahan teks versi di atas untuk cek manual." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/checkUpdateBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cek Update" />

                        <Button
                            android:id="@+id/downloadUpdateBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Unduh APK"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB: LOG -->
        <LinearLayout
            android:id="@+id/panelLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Toolbar log: counter + aksi. Tetap terlihat; hanya daftar log
                 yang scroll di bawahnya. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/logCountTv"
                    style="@style/GosoSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="0 baris" />

                <Button
                    android:id="@+id/logPauseBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Jeda"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/logCopyBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Salin"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/logClearBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Bersihkan"
                    android:textColor="@color/status_err"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_log"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/logTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="@color/log_fg"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
