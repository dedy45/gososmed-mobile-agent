<?xml version="1.0" encoding="utf-8"?>
<!-- UI produksi v0.4.0: onboarding 3 langkah untuk pengguna akhir.
     Tidak ada istilah teknis (WS, dump, intent) di layar utama.
     Mode debug (log + uji lokal) tersembunyi: buka dengan tap 7× pada versi. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Status koneksi: satu kalimat jujur, bahasa pengguna. -->
        <TextView
            android:id="@+id/statusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#EEF2F7"
            android:padding="14dp"
            android:text="Memeriksa…"
            android:textSize="15sp" />

        <!-- LANGKAH 1: aksesibilitas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Langkah 1 — Izinkan akses otomatisasi"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openAccessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Aktifkan di Setelan Aksesibilitas" />

        <!-- LANGKAH 2: baterai (penyebab gagal #1 di Xiaomi/Oppo/Vivo) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Langkah 2 — Bebaskan dari hemat baterai"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bebaskan Agent dari Hemat Baterai" />

        <!-- LANGKAH 3: hubungkan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Langkah 3 — Hubungkan HP ini"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairHintTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cara termudah: buka dasbor GoSosmed di browser HP ini → menu HP Pengguna (BYOD) → tombol Hubungkan HP. Aplikasi ini akan terbuka dan tersambung otomatis."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Fallback manual: hanya kode, tanpa URL server. -->
        <EditText
            android:id="@+id/pairCodeEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Atau ketik kode 8 karakter dari dasbor"
            android:inputType="textCapCharacters"
            android:maxLength="8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hubungkan" />

        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Putuskan Sambungan" />

        <TextView
            android:id="@+id/pairTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ===== MODE DEBUG (tersembunyi; buka dengan tap 7× pada versi) ===== -->
        <LinearLayout
            android:id="@+id/debugSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODE DEBUG"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/wsUrlEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Override URL WS (kosong = default produksi)"
                android:inputType="textUri"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dumpBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dump" />

                <Button
                    android:id="@+id/packageBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Package" />

                <Button
                    android:id="@+id/backBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Back" />

                <Button
                    android:id="@+id/homeBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Home" />
            </LinearLayout>

            <Button
                android:id="@+id/tapBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap First Clickable" />

            <TextView
                android:id="@+id/logTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F5F5F5"
                android:minLines="10"
                android:padding="8dp"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
