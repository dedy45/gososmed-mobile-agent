<?xml version="1.0" encoding="utf-8"?>
<!-- UI produksi v0.4.1 — informatif ala referensi NeuralBridge:
     banner status besar, kartu info perangkat, checklist izin dengan status
     GRANTED/tombol aksi, log perintah dengan latensi yang selalu terlihat.
     Mode debug (uji lokal + override URL) tetap tersembunyi: tap 7× versi. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ===== STATUS ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EEF2F7"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/statusBigTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● MEMERIKSA…"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- ===== INFO PERANGKAT (ala DEVICE INFO NeuralBridge) ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PERANGKAT INI"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/deviceInfoTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F7F8FA"
            android:padding="12dp"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.35" />

        <!-- ===== SETUP: checklist izin ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SETUP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F7F8FA"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Aksesibilitas -->
            <TextView
                android:id="@+id/permA11yTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Akses otomatisasi (Aksesibilitas)"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inti otomatisasi: membaca layar dan mengetuk atas persetujuan Anda"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />
            <Button
                android:id="@+id/openAccessibilityBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aktifkan" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#22000000" />

            <!-- Baterai -->
            <TextView
                android:id="@+id/permBatteryTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bebas hemat baterai"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mencegah Android mematikan agent di latar belakang (penting di Xiaomi/Oppo/Vivo)"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />
            <Button
                android:id="@+id/batteryBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bebaskan" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#22000000" />

            <!-- Notifikasi -->
            <TextView
                android:id="@+id/permNotifTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifikasi"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menampilkan status koneksi agent yang sedang berjalan"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />
            <Button
                android:id="@+id/notifBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Izinkan" />
        </LinearLayout>

        <!-- ===== HUBUNGKAN ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="HUBUNGKAN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/pairHintTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cara termudah: buka dasbor GoSosmed di browser HP ini → HP Pengguna (BYOD) → Terbitkan kode → Hubungkan HP ini. Aplikasi terbuka dan tersambung otomatis."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/pairCodeEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Atau ketik kode 8 karakter dari dasbor"
            android:inputType="textCapCharacters"
            android:maxLength="8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hubungkan" />

        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Putuskan Sambungan" />

        <TextView
            android:id="@+id/pairTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ===== LOG (selalu terlihat — transparansi untuk pemilik HP) ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="LOG AKTIVITAS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/logTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F5F5F5"
            android:minLines="10"
            android:padding="10dp"
            android:textSize="11sp"
            android:typeface="monospace" />

        <!-- ===== MODE DEBUG (tersembunyi; tap 7× pada versi) ===== -->
        <LinearLayout
            android:id="@+id/debugSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#33000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODE DEBUG"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/wsUrlEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Override URL WS (kosong = default produksi)"
                android:inputType="textUri"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dumpBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dump" />

                <Button
                    android:id="@+id/packageBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Package" />

                <Button
                    android:id="@+id/backBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Back" />

                <Button
                    android:id="@+id/homeBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Home" />
            </LinearLayout>

            <Button
                android:id="@+id/tapBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap First Clickable" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
