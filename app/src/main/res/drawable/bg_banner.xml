<?xml version="1.0" encoding="utf-8"?>
<!-- Latar HUD Corner Brackets (Nexus 2048 / Ember theme sesuai Screenshot_5.png). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Permukaan dasar -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/banner_bg" />
            <stroke android:width="1dp" android:color="@color/card_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- 2. Siku Pojok Atas-Kiri (Top-Start) -->
    <item android:gravity="top|start" android:width="16dp" android:height="2dp" android:top="2dp" android:left="2dp" android:start="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="2dp" android:height="16dp" android:top="2dp" android:left="2dp" android:start="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>

    <!-- 3. Siku Pojok Atas-Kanan (Top-End) -->
    <item android:gravity="top|end" android:width="16dp" android:height="2dp" android:top="2dp" android:right="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="2dp" android:height="16dp" android:top="2dp" android:right="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>

    <!-- 4. Siku Pojok Bawah-Kiri (Bottom-Start) -->
    <item android:gravity="bottom|start" android:width="16dp" android:height="2dp" android:bottom="2dp" android:left="2dp" android:start="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="2dp" android:height="16dp" android:bottom="2dp" android:left="2dp" android:start="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>

    <!-- 5. Siku Pojok Bawah-Kanan (Bottom-End) -->
    <item android:gravity="bottom|end" android:width="16dp" android:height="2dp" android:bottom="2dp" android:right="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="2dp" android:height="16dp" android:bottom="2dp" android:right="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ember" />
        </shape>
    </item>
</layer-list>
