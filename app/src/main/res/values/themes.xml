<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 DayNight: mengikuti tema sistem (light/dark). Tanpa ActionBar
         agar header dibuat sendiri (tampilan lebih modern & hemat ruang). -->
    <style name="Theme.GosomedAgent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <!-- Kartu info: permukaan netral, sudut membulat, tanpa shadow berat. -->
    <style name="GosoCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Judul bagian (huruf kecil tebal, abu sekunder). -->
    <style name="GosoSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Teks bantuan sekunder. -->
    <style name="GosoHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
