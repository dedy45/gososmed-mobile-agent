<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outbound WebSocket to GoSosmed agenthub; no inbound ports needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- killApp: kill background processes of a target app (force-stop is
         shell-only; this is the honest subset the agent can do). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- hasPackage/startApp: package visibility for launch intents and
         installed-package checks (Android 11+ package visibility). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Deep-link baterai: ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS agar
         user bisa membebaskan agent dari optimasi baterai dalam 1 tap dari
         UI onboarding (penyebab kegagalan #1 di MIUI/dkk). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v0.7.1 AKAR MASALAH HARVEST (bukti produksi 2026-09-11: startApp
         melapor ok=true tetapi foreground tetap com.miui.home di 5 platform).

         Sejak Android 10 (API 29) memulai activity dari background DIBLOKIR
         (Background Activity Launch). AccessibilityService kita tidak punya
         window terlihat, jadi setiap startApp dihitung sebagai BAL dan ditelan
         sistem TANPA exception - itulah sebabnya APK melapor sukses palsu.

         SYSTEM_ALERT_WINDOW adalah pengecualian BAL yang didokumentasikan:
         app yang punya overlay window dianggap punya window terlihat. Ini
         pola yang dipakai mobilerun-portal (droidrun) dan satu-satunya izin
         penting yang TIDAK kita miliki. Overlay 1x1 transparan dipasang
         AgentOverlay tepat sebelum launch. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- wakeScreen() memanggil PowerManager.newWakeLock; TANPA izin ini
         wakelock melempar SecurityException sehingga command `wake` (P0-4)
         selalu gagal diam-diam saat layar padam. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Agent kembali online setelah HP reboot tanpa dibuka manual. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- v0.9.0 TRANSPORT TIER 1 (ADB lokal).
         v0.8.0 memakai aplikasi pihak ketiga Shizuku; mulai v0.9.0 Shizuku
         DIHAPUS TOTAL (izin moe.shizuku.manager.permission.API_V23 dan
         ShizukuProvider sudah tidak ada di berkas ini). Transport shell kini
         klien ADB yang tertanam di APK sendiri: pairing ke adbd lokal lewat
         Debug nirkabel, lalu perintah dijalankan sebagai uid 2000 (user
         `shell`) - hak yang sama dengan `adb shell`, tanpa aplikasi tambahan.

         Efeknya sama seperti sebelumnya: `am start` bukan lagi Background
         Activity Launch, `am force-stop` benar-benar mereset app, dan
         `input tap` memakai INJECT_EVENTS. Bila belum di-pair, agent tetap
         jalan di jalur accessibility (degradasi mulus, bukan crash).

         Tidak ada izin baru yang dibutuhkan di manifest untuk ini: ADB lokal
         memakai socket loopback, dan INTERNET sudah dideklarasikan di atas. -->

    <!-- Android 11+ package visibility: selain QUERY_ALL_PACKAGES, deklarasi
         <queries> eksplisit memastikan queryIntentActivities /
         getLaunchIntentForPackage / LauncherApps.getActivityList tetap
         melihat app target (pola mobilerun-portal). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AgentApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.GosomedAgent"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- P0-3 (Plan 07): cleartext TIDAK lagi dibuka global. Config utama
             (res/xml/network_security_config.xml) menolak seluruh trafik
             cleartext — produksi wss:// (Cloudflare Tunnel) saja. Build DEBUG
             menimpa lewat src/debug/res/xml agar ws:// LAN dev tetap bisa
             dipakai saat pengembangan; kriteria lulus P0-3: domain ws://
             arbitrary GAGAL di build release. -->

        <!-- v0.9.0: ShizukuProvider DIHAPUS. Transport shell kini klien ADB
             lokal di dalam APK ini, jadi tidak ada binder pihak ketiga yang
             perlu diterima. -->

        <!-- Validation/control channel (DEBUG saja — kode menolak di release,
             lihat AgentReceiver). Exported agar adb shell am broadcast bisa
             mengirim untuk validasi P0. -->
        <receiver
            android:name=".AgentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gososmed.agent.CMD" />
            </intent-filter>
        </receiver>

        <!-- Foreground service keeps the agent process foreground so that
             BroadcastReceiver commands work on Android 12+ (they are blocked
             when the app is in the background). This is also the production
             shape: the agent is a persistent service, not an Activity. -->
        <service
            android:name=".AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_automation_agent_byod" />
        </service>

        <!-- v0.9.6: Service pendukung untuk Floating Overlay Window & Notifikasi
             Pairing ADB agar overlay tidak ditelan atau dimatikan OS saat pindah ke Pengaturan.

             CACAT v0.9.5 yang DIPERBAIKI DI SINI: service ini dideklarasikan
             TANPA `android:foregroundServiceType`. Dengan targetSdk 34,
             memanggil `startForeground()` dari service tanpa tipe yang
             dideklarasikan melempar MissingForegroundServiceTypeException —
             service MATI SEBELUM overlay atau notifikasi sempat dibuat. Itulah
             akar teknis keluhan "klik Hubungkan ADB → overlay tidak muncul":
             bukan overlay-nya ditolak, service-nya crash lebih dulu.

             Tipe `specialUse` + properti subtype dipakai agar konsisten dengan
             AgentForegroundService dan lolos pemeriksaan Play/Android 14. -->
        <service
            android:name=".privileged.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="adb_wireless_pairing_assistant" />
        </service>

        <!-- AccessibilityService: source of truth for the UI hierarchy and
             the executor for tap/text/swipe — no root, no adb required. -->
        <service
            android:name=".AgentAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Auto-pairing TANPA ketik manual: dasbor menerbitkan tautan
                 gososmed://pair?ws=<ws_url>&code=<KODE8> yang dibuka di HP
                 (tap dari browser HP / pindai QR dengan kamera bawaan) →
                 Android membuka APK ini, kode terisi, koneksi langsung
                 dijalin. Pola yang sama dipakai aplikasi pairing pada
                 umumnya (deep link satu-tap). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="gososmed"
                    android:host="pair" />
            </intent-filter>
        </activity>
    </application>
</manifest>
